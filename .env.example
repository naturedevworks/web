KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
# Set this only when Client Secret is enabled for the Kakao REST API key.
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
COOKIE_SECURE=false
SESSION_DAYS=30
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORTONE_STORE_ID=replace-with-portone-store-id
PORTONE_CHANNEL_KEY=replace-with-portone-toss-channel-key
# Server only. Never add this value to a VITE_ variable.
PORTONE_API_SECRET=replace-with-portone-v2-api-secret
